# 開発用Dockerfile（ホットリロード対応）
FROM golang:1.24.4-alpine

# 必要なツールをインストール
RUN apk add --no-cache git

# Airをインストール（ホットリロード用）
RUN go install github.com/air-verse/air@latest

# 作業ディレクトリを設定
WORKDIR /app

# 依存関係ファイルをコピー
COPY go.mod go.sum ./

# 依存関係をダウンロード
RUN go mod download

# ソースコードをコピー
COPY . .

# ポートを公開
EXPOSE 8080

# Airでホットリロード実行
CMD ["air", "-c", ".air.toml"]